# ==============================================================================
# LANCE configuration (.env)
# Copy this file to `.env` and fill in the values for your host.
# NOTE: `.env` files use `#` for comments (not `//`) on their own line so Docker
# Compose does not treat trailing comments as part of a variable's value.
# ==============================================================================

# ── 1. Local LLM (Ollama or any OpenAI-compatible server) ────────────────────
# Applied automatically on every container boot (single source of truth).
# Pull your chat model on Ollama first, e.g. `ollama pull qwen2.5:14b`.

# Local provider name registered in LANCE (`ollama` for partner deploys, or `ollama-umons`).
AGENT_PROVIDER=ollama

# OpenAI-compatible endpoint of your Ollama server.
# Use `http://localhost:11434/v1` when Ollama runs on the same Linux host (host network mode),
# or `http://<gpu-host-ip>:11434/v1` if Ollama runs on a separate GPU machine.
LANCE_LLM_BASE_URL=http://localhost:11434/v1

# Exact Ollama chat model tag to serve (becomes the default model in the dashboard).
# Examples: `qwen2.5:3b` (CPU smoke test), `qwen2.5:7b` / `qwen2.5:14b` (16 GB GPU), `qwen3.5:27b` (24+ GB GPU).
LANCE_LLM_MODEL=qwen2.5:14b

# Optional: widen the HTTP read timeout (seconds) for large/slow local models.
# LANCE_API_TIMEOUT_S=300

# ── 2. Local embeddings (ChromaDB knowledge store — 100% offline) ────────────
# Pull once on Ollama: `ollama pull nomic-embed-text`. Nothing leaves your network.

# Embedding backend: `ollama` (local, default) or `voyage` (cloud, opt-in).
LANCE_EMBEDDINGS=ollama

# Ollama embedding model tag used to index security skills locally.
LANCE_EMBED_MODEL=nomic-embed-text

# Optional: only set this if embeddings run on a different Ollama host than LANCE_LLM_BASE_URL.
# LANCE_EMBED_BASE_URL=http://localhost:11434/v1

# ── 3. Dashboard access & security ───────────────────────────────────────────

# Local admin password you invent yourself (e.g. `openssl rand -hex 24`).
# Protects admin API changes (editing providers/models). Can be left empty for a quick local smoke test.
LANCE_ADMIN_TOKEN=

# Network interface the dashboard listens on inside the container.
# Keep `127.0.0.1` in Linux host-mode so the dashboard stays off the LAN (reach it via SSH tunnel).
# Change to `0.0.0.0` ONLY when using Docker bridge networking (`ports:` mapping).
LANCE_BIND_HOST=127.0.0.1

# Optional extra hardening: set to `1` to require LANCE_ADMIN_TOKEN (Bearer header) to start audits via API.
# LANCE_REQUIRE_LAUNCH_AUTH=1

# ── 4. Optional / advanced (not needed for offline partner deployments) ──────

# Optional NIST NVD API key for higher online CVE lookup rate limits (ignored when offline).
# NVD_API_KEY=

# Optional report-writing timeout overrides (seconds).
# LANCE_LOCAL_MOE_REPORT_PHASE_TIMEOUT=600
# LANCE_REPORT_SECTION_TIMEOUT=45

# Cloud API keys (development / non-offline setups only — leave unset for local Ollama):
# MINIMAX_API_KEY=
# GLM_API_KEY=
# DASHSCOPE_API_KEY=
# VOYAGE_API_KEY=
