# ── LLM provider (at least one required, matching --provider) ────────────────
# Choose --provider explicitly, or set AGENT_PROVIDER; there is no implicit provider.
# Dashboard provider mutations require this non-empty administrative token.
# Keep it out of source control and share it only through the deployment secret store.
LANCE_ADMIN_TOKEN=
# Dashboard bind host. Scan launch (/api/pipeline/start) is unauthenticated, so in
# host-mode (the single-host partner default) keep this at 127.0.0.1 — the dashboard
# is then not reachable from the LAN; reach it over an SSH tunnel. Use 0.0.0.0 only
# for bridge networking (Docker maps the published port) or to expose it on purpose.
LANCE_BIND_HOST=127.0.0.1
# MINIMAX_API_KEY=...               # --provider minimax
# GLM_API_KEY=...                   # --provider glm
# DASHSCOPE_API_KEY=...             # --provider qwen

# ── Knowledge store embeddings (required) ─────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── CVE lookup (optional — increases NVD rate limit) ─────────────────────────
# NVD_API_KEY=...

# ── Report writing: independent sections, full and compact ────────────────────
# LANCE_LOCAL_MOE_REPORT_PHASE_TIMEOUT=600  # total writing budget (seconds)
# LANCE_REPORT_SECTION_TIMEOUT=45          # maximum per individual section
