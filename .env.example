# ── LLM provider (at least one required, matching --provider) ────────────────
# Codex subscription needs no variable here: install the CLI and run `codex login`.
# LANCE_CODEX_CLI_PATH=/absolute/path/to/codex  # optional for restricted services
# Dashboard provider mutations require this non-empty administrative token.
# Keep it out of source control and share it only through the deployment secret store.
LANCE_ADMIN_TOKEN=
OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...      # --provider anthropic
# MINIMAX_API_KEY=...               # --provider minimax
# GLM_API_KEY=...                   # --provider glm
# DASHSCOPE_API_KEY=...             # --provider qwen

# ── Knowledge store embeddings (required) ─────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── CVE lookup (optional — increases NVD rate limit) ─────────────────────────
# NVD_API_KEY=...
