# Install inside nginx's http{} context (for example /etc/nginx/conf.d/).
# Replace evaluator.example and certificate paths before enabling.
limit_req_zone $binary_remote_addr zone=sealed_launch:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=sealed_poll:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name evaluator.example;

    ssl_certificate /etc/letsencrypt/live/evaluator.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evaluator.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Never enable access/body/header logging, mirroring, debug capture, WAF
    # sampling or tracing/APM on this virtual host.
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    client_max_body_size 8k;

    location = /api/sealed/suites {
        limit_req zone=sealed_launch burst=1 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8502;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_redirect off;
    }

    location ^~ /api/sealed/suites/ {
        limit_req zone=sealed_poll burst=10 nodelay;
        limit_except GET DELETE { deny all; }
        proxy_pass http://127.0.0.1:8502;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_redirect off;
    }

    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://127.0.0.1:8502;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_redirect off;
    }
}
